    "@sveltejs/kit": "^3.1",
    "@sveltejs/vite-plugin-svelte": "^7.1",
    "svelte": "^5.56",
    "svelte-check": "^4.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
